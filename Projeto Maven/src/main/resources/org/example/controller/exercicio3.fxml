<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Exercicio3Controller">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Exercício 3 - Caixa com Desconto"><font><Font name="System Bold" size="18.0" /></font></Label>
      <TextField fx:id="txtPreco" promptText="Preço do Produto (R$)" />
      <TextField fx:id="txtQtd" promptText="Quantidade" />
      <Button mnemonicParsing="false" onAction="#adicionarProduto" text="Adicionar Produto" />
      <Button mnemonicParsing="false" onAction="#calcularTotal" text="Finalizar e Calcular Total" />
      <TextArea fx:id="txtExtrato" prefHeight="150.0" />
      <Button mnemonicParsing="false" onAction="#voltar" text="Voltar ao Menu" />
   </children>
</VBox>