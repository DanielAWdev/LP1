<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Exercicio7Controller">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label text="Exercício 7 - Aluguel de Carro"><font><Font name="System Bold" size="18.0" /></font></Label>
      <TextField fx:id="txtDias" promptText="Quantidade de dias" />
      <TextField fx:id="txtKm" promptText="Quilometragem percorrida (km)" />
      <TextField fx:id="txtLimite" promptText="Limite de km antes da cobrança extra" />
      <TextField fx:id="txtDiaria" promptText="Valor da diária (R$)" />
      <TextField fx:id="txtAdicional" promptText="Valor adicional por km extra (R$)" />
      <Button mnemonicParsing="false" onAction="#calcular" text="Calcular Aluguel" />
      <Label fx:id="lblResultado" text="" />
      <Button mnemonicParsing="false" onAction="#voltar" text="Voltar ao Menu" />
   </children>
</VBox>