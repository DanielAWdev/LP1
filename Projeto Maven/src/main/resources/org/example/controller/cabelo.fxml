<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CabeloController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <children>
        <Label text="Cadastro de Cabelo"><font><Font name="System Bold" size="18.0" /></font></Label>
        <TextField fx:id="txtCor" promptText="Cor" />
        <TextField fx:id="txtComprimento" promptText="Comprimento (cm)" />
        <TextField fx:id="txtEstilo" promptText="Estilo" />
        <TextField fx:id="txtTipo" promptText="Tipo" />
        <TextField fx:id="txtTextura" promptText="Textura" />
        <Button mnemonicParsing="false" onAction="#cadastrarCabelo" text="Cadastrar Cabelo" />
        <Label fx:id="lblResultado" text="" />
        <Button mnemonicParsing="false" onAction="#voltar" text="Voltar ao Menu" />
    </children>
</VBox>